{
  "netflix_subtitle_config": {
    "description": "Netflix级别专业字幕配置",
    "version": "1.0",
    "created": "2025-08-30",
    "style_profiles": {
      "netflix_standard": {
        "name": "Netflix标准样式",
        "font_family": "Arial",
        "font_size": 24,
        "font_color": "#FFFFFF",
        "font_weight": "bold",
        "background_color": "rgba(0,0,0,0.75)",
        "outline_color": "#000000",
        "outline_width": 2,
        "shadow_enabled": true,
        "shadow_color": "rgba(0,0,0,0.5)",
        "shadow_offset_x": 1,
        "shadow_offset_y": 1
      },
      "netflix_minimal": {
        "name": "Netflix简约样式",
        "font_family": "Arial",
        "font_size": 22,
        "font_color": "#FFFFFF",
        "font_weight": "normal",
        "background_color": "transparent",
        "outline_color": "#000000",
        "outline_width": 3,
        "shadow_enabled": true,
        "shadow_color": "rgba(0,0,0,0.8)",
        "shadow_offset_x": 2,
        "shadow_offset_y": 2
      },
      "netflix_accessibility": {
        "name": "Netflix无障碍样式",
        "font_family": "Arial",
        "font_size": 28,
        "font_color": "#FFFF00",
        "font_weight": "bold",
        "background_color": "rgba(0,0,0,0.9)",
        "outline_color": "#000000",
        "outline_width": 2,
        "shadow_enabled": false,
        "high_contrast": true
      }
    },
    "timing_rules": {
      "min_display_time": 1.0,
      "max_display_time": 8.0,
      "min_gap_between_subtitles": 0.5,
      "reading_speed_wpm": 200,
      "words_per_second": 3.5,
      "gap_threshold": 0.8,
      "subtitle_overlap_tolerance": 0.1
    },
    "layout_rules": {
      "max_chars_per_line": 40,
      "max_lines": 2,
      "preferred_chars_per_line": 35,
      "line_spacing": 1.2,
      "paragraph_spacing": 1.5,
      "margin_bottom": 60,
      "margin_left": 80,
      "margin_right": 80,
      "safe_area_margin": 5,
      "alignment": "center"
    },
    "text_processing": {
      "smart_line_breaks": true,
      "auto_punctuation_removal": true,
      "preserve_formatting": false,
      "line_break_chars": "，。！？；：",
      "avoid_orphans": true,
      "hyphenation": false,
      "capitalize_sentences": false,
      "remove_redundant_spaces": true
    },
    "smart_subtitle_processing": {
      "enabled": true,
      "max_length": 75,
      "target_multiplier": 1.2,
      "smart_split": true,
      "use_ai_splitting": true,
      "character_weights": {
        "chinese": 1.75,
        "japanese": 1.75,
        "korean": 1.5,
        "english": 1.0,
        "punctuation": 0.8,
        "space": 0.5,
        "number": 0.8
      },
      "punctuation_priority": {
        "。": 10,
        ".": 10,
        "！": 9,
        "!": 9,
        "？": 9,
        "?": 9,
        "；": 8,
        ";": 8,
        "：": 7,
        ":": 7,
        "，": 6,
        ",": 6,
        "、": 5,
        " ": 3,
        "-": 2,
        "/": 1
      },
      "semantic_splitting": {
        "enabled": true,
        "look_ahead_chars": 10,
        "min_priority_threshold": 6
      },
      "ai_config": {
        "service_type": "openai",
        "api_key": "test-key",
        "model": "gpt-3.5-turbo",
        "base_url": "https://api.openai.com/v1",
        "timeout": 30,
        "max_retries": 3
      }
    },
    "quality_settings": {
      "anti_aliasing": true,
      "subpixel_rendering": true,
      "gamma_correction": 2.2,
      "contrast_enhancement": 1.1,
      "blur_radius": 0,
      "sharpening": 0,
      "color_temperature": 6500
    },
    "animation_settings": {
      "enable_fade": true,
      "fade_in_duration": 0.2,
      "fade_out_duration": 0.2,
      "subtitle_entrance": "fade",
      "subtitle_exit": "fade",
      "smooth_transitions": true
    },
    "language_specific": {
      "zh-CN": {
        "font_families": [
          "Microsoft YaHei",
          "SimHei",
          "Arial Unicode MS"
        ],
        "character_spacing": 0,
        "line_height_adjustment": 1.0,
        "punctuation_handling": "standard"
      },
      "en-US": {
        "font_families": [
          "Arial",
          "Helvetica",
          "sans-serif"
        ],
        "character_spacing": 0,
        "line_height_adjustment": 1.0,
        "punctuation_handling": "standard"
      }
    },
    "accessibility_features": {
      "high_contrast_mode": false,
      "large_text_mode": false,
      "color_blind_friendly": true,
      "screen_reader_support": true,
      "keyboard_navigation": true,
      "focus_indicators": true
    },
    "performance_settings": {
      "cache_enabled": true,
      "preload_subtitles": true,
      "optimize_for_mobile": false,
      "gpu_acceleration": true,
      "memory_limit_mb": 512,
      "background_processing": true
    },
    "debugging": {
      "show_timing_info": false,
      "highlight_boundaries": false,
      "show_character_count": false,
      "log_processing_time": false,
      "validate_srt_format": true
    }
  }
}