{
  "_meta": {
    "version": "1.0.0",
    "description": "系统配置模板 - 用于初始化 system_config 表",
    "created_at": "2025-11-27",
    "note": "此文件定义了系统初始化时的默认配置，管理员可通过数据库修改"
  },
  
  "system_settings": {
    "description": "全局系统设置",
    "config_value": {
      "allow_registration": false,
      "max_video_duration": 3600,
      "max_slides_count": 100,
      "max_upload_size_mb": 100,
      "maintenance_mode": false,
      "debug_mode": false,
      "log_level": "INFO",
      "session_timeout_hours": 24,
      "jwt_expiry_hours": 1,
      "default_language": "zh-CN"
    }
  },
  
  "default_user_config": {
    "description": "新用户默认配置模板",
    "config_value": {
      "ai": {
        "default_service": "custom",
        "openai": {
          "api_key": "",
          "base_url": "https://api.openai.com/v1",
          "model": "gpt-3.5-turbo",
          "timeout": 300,
          "max_retries": 3,
          "support_json": true
        },
        "anthropic": {
          "api_key": "",
          "base_url": "https://api.anthropic.com",
          "model": "claude-3-sonnet-20240229",
          "timeout": 300,
          "max_retries": 3
        },
        "custom": {
          "api_key": "",
          "base_url": "",
          "model": "",
          "timeout": 300,
          "max_retries": 3,
          "support_json": true
        },
        "max_workers": 4
      },
      "tts": {
        "preferred_engine": "edge_tts",
        "edge_voice": "zh-CN-XiaoxiaoNeural",
        "edge_rate": "+0%",
        "edge_pitch": "+0Hz",
        "fish_api_key": "",
        "fish_character": "",
        "fish_character_id": "",
        "openai_api_key": "",
        "openai_voice": "alloy",
        "openai_model": "tts-1",
        "azure_api_key": "",
        "azure_region": "eastus",
        "azure_voice": "zh-CN-XiaoxiaoNeural",
        "sample_rate": 22050,
        "max_retries": 3,
        "timeout": 30
      },
      "video": {
        "resolution": "1920x1080",
        "fps": 30,
        "video_bitrate": "8000k",
        "background_color": "#000000",
        "include_subtitles": true,
        "audio_bitrate": "192k",
        "audio_codec": "aac",
        "video_codec": "libx264",
        "preset": "medium",
        "crf": 18,
        "profile": "high",
        "level": "4.1",
        "pixel_format": "yuv420p"
      },
      "subtitle": {
        "enabled": true,
        "font_family": "Microsoft YaHei",
        "font_size": 40,
        "font_color": "#FFFFFF",
        "background_color": "rgba(0,0,0,0.8)",
        "position": "bottom",
        "max_chars_per_line": 36,
        "use_enhanced_mode": true
      },
      "smart_subtitle": {
        "enabled": true,
        "splitter_type": "ai_semantic",
        "max_chars_per_line": 36,
        "max_lines": 2,
        "netflix_style": true,
        "netflix_v2_enabled": true,
        "use_enhanced_generator": true
      },
      "netflix_v2": {
        "enabled": true,
        "style_preset": "videolingo_netflix",
        "max_chars_per_line": 36,
        "validation_level": "netflix",
        "chinese_weight": 1.75,
        "english_weight": 1.0,
        "enable_semantic_splitting": true,
        "max_optimization_rounds": 5,
        "quality_threshold": 0.7,
        "font_color": "&H00FFFF",
        "font_size": 17,
        "outline_color": "&H000000",
        "outline_width": 1,
        "background_alpha": 0.8,
        "enable_quality_validation": true,
        "auto_fix_issues": true,
        "strict_netflix_compliance": true
      },
      "advanced_features": {
        "enhanced_subtitles": true,
        "frame_sync_optimization": true,
        "netflix_v2_mode": true,
        "phase3_alignment": true,
        "ai_content_understanding": true,
        "audio_intelligent_sync": true,
        "lightweight_mode": false
      }
    }
  },
  
  "render_config": {
    "description": "渲染引擎配置",
    "config_value": {
      "render_engine": {
        "type": "headless_browser",
        "enabled": true,
        "quality": 95,
        "format": "jpeg",
        "width": 1600,
        "height": 900,
        "device_scale_factor": 1,
        "wait_for_fonts": true,
        "timeout": 30000
      }
    }
  },
  
  "tts_services": {
    "description": "TTS 服务配置",
    "config_value": {
      "available_engines": ["edge_tts", "fish_tts", "openai_tts", "azure_tts"],
      "default_engine": "edge_tts",
      "services_config": {
        "edge_tts": {
          "name": "Edge TTS",
          "description": "微软Edge浏览器TTS服务，免费高质量",
          "enabled": true,
          "default_voice": "zh-CN-XiaoxiaoNeural",
          "supports_rate": true,
          "supports_pitch": true
        },
        "fish_tts": {
          "name": "Fish Audio",
          "description": "Fish Audio声音克隆服务",
          "enabled": true,
          "requires_api_key": true
        },
        "openai_tts": {
          "name": "OpenAI TTS",
          "description": "OpenAI文字转语音服务",
          "enabled": true,
          "requires_api_key": true,
          "models": ["tts-1", "tts-1-hd"],
          "voices": ["alloy", "echo", "fable", "onyx", "nova", "shimmer"]
        },
        "azure_tts": {
          "name": "Azure TTS",
          "description": "微软Azure认知服务TTS",
          "enabled": true,
          "requires_api_key": true
        }
      }
    }
  },
  
  "ai_services": {
    "description": "AI 服务配置",
    "config_value": {
      "available_services": ["openai", "anthropic", "custom"],
      "default_service": "custom",
      "services_config": {
        "openai": {
          "name": "OpenAI",
          "description": "OpenAI GPT模型服务",
          "default_base_url": "https://api.openai.com/v1",
          "supports_json": true,
          "models": [
            {"value": "gpt-3.5-turbo", "label": "GPT-3.5 Turbo", "is_default": true},
            {"value": "gpt-4o-mini", "label": "GPT-4o Mini"},
            {"value": "gpt-4o", "label": "GPT-4o"},
            {"value": "gpt-4", "label": "GPT-4"},
            {"value": "gpt-4-turbo", "label": "GPT-4 Turbo"}
          ]
        },
        "anthropic": {
          "name": "Anthropic",
          "description": "Anthropic Claude模型服务",
          "default_base_url": "https://api.anthropic.com",
          "supports_json": false,
          "models": [
            {"value": "claude-3-haiku-20240307", "label": "Claude 3 Haiku"},
            {"value": "claude-3-sonnet-20240229", "label": "Claude 3 Sonnet", "is_default": true},
            {"value": "claude-3-opus-20240229", "label": "Claude 3 Opus"}
          ]
        },
        "custom": {
          "name": "自定义API",
          "description": "兼容OpenAI格式的自定义API服务",
          "default_base_url": "",
          "supports_json": true,
          "models": []
        }
      }
    }
  },
  
  "manual_split_config": {
    "description": "手动字幕分割配置",
    "config_value": {
      "enabled": true,
      "split_strategy": {
        "method": "newline_split",
        "fallback_to_auto": true
      },
      "newline_split": {
        "enabled": true,
        "audio_processing": {
          "strategy": "separate_generation",
          "merge_segments": false,
          "normalize_volume": true,
          "add_segment_gap": 0.1
        },
        "timestamp_calculation": {
          "method": "cumulative",
          "precision": "millisecond",
          "adjust_for_readability": true
        }
      },
      "quality_control": {
        "min_segment_length": 5,
        "max_segments_per_slide": 8,
        "min_segment_duration": 1.0,
        "max_segment_duration": 10.0,
        "validate_split_points": true,
        "auto_optimize_timing": true
      },
      "subtitle_display_mode": {
        "single_line_mode": true,
        "time_allocation": {
          "method": "proportional",
          "based_on": "character_count",
          "min_line_duration": 1.0,
          "max_line_duration": 8.0
        }
      }
    }
  },
  
  "phase3_intelligent_alignment": {
    "description": "Phase3智能对齐配置",
    "config_value": {
      "enabled": true,
      "precision_level": "enhanced",
      "audio_analysis": {
        "sample_rate": 16000,
        "frame_length": 1024,
        "hop_length": 512
      },
      "alignment_settings": {
        "dtw_step_pattern": "symmetric2",
        "boundary_detection_threshold": 0.3,
        "min_segment_duration": 0.5
      },
      "quality_control": {
        "min_confidence_threshold": 0.7,
        "max_time_deviation": 200,
        "enable_validation": true
      }
    }
  }
}
