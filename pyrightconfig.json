{
    "include": [
        "flask_backend/**"
    ],
    "extraPaths": [
        "./flask_backend",
        "./flask_backend/core",
        "./flask_backend/api"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*"
    ],
    "reportMissingImports": true,
    "reportMissingTypeStubs": false,
    "pythonVersion": "3.8",
    "typeCheckingMode": "basic"
}
