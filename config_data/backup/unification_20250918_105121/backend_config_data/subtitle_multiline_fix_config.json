{
  "subtitle_multiline_fix_config": {
    "description": "修复多行字幕显示问题的配置优化",
    "version": "1.1",
    "created": "2025-09-11",
    
    "character_weight_adjustments": {
      "chinese": 1.8,
      "japanese": 1.8,
      "korean": 1.6,
      "english": 0.8,
      "punctuation": 0.5,
      "space": 0.25,
      "number": 0.7,
      "emoji": 1.3
    },
    
    "line_control_rules": {
      "max_lines_strict": 2,
      "max_chars_per_line_chinese": 26,
      "max_chars_per_line_english": 40,
      "preferred_chars_per_line_chinese": 22,
      "enforce_line_limit": true,
      "auto_truncate_overflow": true,
      "priority_line_limit_over_semantic": true,
      "target_weight_ratio": 0.8,
      "balance_tolerance": 0.3
    },
    
    "smart_splitting_config": {
      "enabled": true,
      "max_line_enforcement": true,
      "line_priority_boost": 8,
      "semantic_splitting_threshold": 10,
      "look_ahead_chars": 8,
      "min_priority_threshold": 8,
      "force_split_on_overflow": true
    },
    
    "resolution_adaptive_font": {
      "enabled": true,
      "base_resolution": [1920, 1080],
      "base_font_size": 24,
      "scaling_rules": {
        "720p": {"multiplier": 0.7, "font_size": 18},
        "1080p": {"multiplier": 1.0, "font_size": 24},
        "1440p": {"multiplier": 1.3, "font_size": 32},
        "4k": {"multiplier": 2.0, "font_size": 48}
      },
      "min_font_size": 16,
      "max_font_size": 60
    },
    
    "validation_rules": {
      "reject_over_max_lines": true,
      "warn_on_long_lines": true,
      "auto_adjust_font_on_overflow": true,
      "fallback_to_single_line": false,
      "compress_spaces": true,
      "remove_redundant_punctuation": true
    },
    
    "debug_settings": {
      "log_character_analysis": false,
      "highlight_line_breaks": false,
      "show_weight_calculations": false,
      "export_split_decisions": false
    }
  }
}
