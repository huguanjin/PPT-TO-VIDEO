# 开发环境配置

# 前端开发服务器
VITE_DEV_PORT=5173
VITE_DEV_HOST=localhost

# 后端API服务器配置 - 统一Flask后端 (推荐使用)
VITE_API_HOST=localhost
VITE_API_PORT=5000
VITE_API_BASE_URL=http://localhost:5000

# 备用后端 - VideoLingo技术融合服务
VITE_API_FALLBACK_URL=http://localhost:8004

# 备用API服务器端口（用于不同的服务）
VITE_PPTIST_API_PORT=8001
VITE_SIMPLE_API_PORT=8002
VITE_WORKFLOW_API_PORT=8003

# 项目管理API路径
VITE_PROJECT_API_PATH=/pm/api

# TTS和工作流API配置
VITE_TTS_CONFIG_PATH=/api/tts/config
VITE_WORKFLOW_PATH=/api/workflow
