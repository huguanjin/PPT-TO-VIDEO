# =============================================================================
# PPTist Docker镜像 - 轻量级自定义nginx版本
# =============================================================================
# 此版本基于最小Alpine镜像手动安装nginx以最大化安全控制
# 优点：完全控制安装过程，可排除不必要组件
# 缺点：需要更多维护，构建时间较长
# =============================================================================

# =============================================================================
# 构建阶段 - Node.js环境
# =============================================================================
FROM node:22-slim AS builder

# 设置工作目录
WORKDIR /app

# 安装系统依赖和安全更新
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 复制package文件
COPY package*.json ./

# 安装依赖
RUN npm ci --only=production

# 复制源代码
COPY . .

# 构建应用
RUN npm run build

# =============================================================================
# 生产阶段 - 自定义最小nginx
# =============================================================================
FROM alpine:3.19 AS production

# 安装nginx和必要工具（最新版本）
RUN apk update && apk upgrade && \
    apk add --no-cache \
    nginx \
    nginx-mod-http-headers-more \
    nginx-mod-http-echo \
    ca-certificates \
    tzdata \
    dumb-init \
    curl \
    && rm -rf /var/cache/apk/* \
    && rm -rf /tmp/*

# 创建nginx用户和必要目录
RUN addgroup -g 101 -S nginx && \
    adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx && \
    mkdir -p /var/log/nginx /var/cache/nginx /var/run /usr/share/nginx/html && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/log/nginx /var/cache/nginx /var/run/nginx.pid /usr/share/nginx/html

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 创建最小化nginx配置
RUN echo 'user nginx;' > /etc/nginx/nginx.conf && \
    echo 'worker_processes auto;' >> /etc/nginx/nginx.conf && \
    echo 'pid /var/run/nginx.pid;' >> /etc/nginx/nginx.conf && \
    echo 'events { worker_connections 1024; }' >> /etc/nginx/nginx.conf && \
    echo 'http {' >> /etc/nginx/nginx.conf && \
    echo '  include /etc/nginx/mime.types;' >> /etc/nginx/nginx.conf && \
    echo '  default_type application/octet-stream;' >> /etc/nginx/nginx.conf && \
    echo '  sendfile on;' >> /etc/nginx/nginx.conf && \
    echo '  tcp_nopush on;' >> /etc/nginx/nginx.conf && \
    echo '  tcp_nodelay on;' >> /etc/nginx/nginx.conf && \
    echo '  keepalive_timeout 65;' >> /etc/nginx/nginx.conf && \
    echo '  gzip on;' >> /etc/nginx/nginx.conf && \
    echo '  server_tokens off;' >> /etc/nginx/nginx.conf && \
    echo '  add_header X-Frame-Options DENY;' >> /etc/nginx/nginx.conf && \
    echo '  add_header X-Content-Type-Options nosniff;' >> /etc/nginx/nginx.conf && \
    echo '  add_header X-XSS-Protection "1; mode=block";' >> /etc/nginx/nginx.conf && \
    echo '  server {' >> /etc/nginx/nginx.conf && \
    echo '    listen 8080;' >> /etc/nginx/nginx.conf && \
    echo '    server_name localhost;' >> /etc/nginx/nginx.conf && \
    echo '    root /usr/share/nginx/html;' >> /etc/nginx/nginx.conf && \
    echo '    index index.html;' >> /etc/nginx/nginx.conf && \
    echo '    location / { try_files $uri $uri/ /index.html; }' >> /etc/nginx/nginx.conf && \
    echo '    location /health { access_log off; return 200 "healthy\n"; }' >> /etc/nginx/nginx.conf && \
    echo '  }' >> /etc/nginx/nginx.conf && \
    echo '}' >> /etc/nginx/nginx.conf

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 设置权限
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# 安全标签
LABEL maintainer="PPTist Team" \
      version="1.0-minimal" \
      description="PPTist Web Application - Minimal Custom nginx" \
      security.level="high" \
      base.image="alpine:3.19"

# 切换到非特权用户
USER nginx

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# 暴露端口
EXPOSE 8080

# 启动nginx
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["nginx", "-g", "daemon off;"]